# ============================================
# Crypto Real-Time Analytics - Configuration
# ============================================
# Copiez ce fichier en .env et adaptez les valeurs

# PostgreSQL
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=crypto_pass_2024
POSTGRES_DB=crypto_analytics

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=crypto-market

# Binance API (publique, pas de clé nécessaire)
BINANCE_BASE_URL=https://api.binance.com
SYMBOLS=BTCUSDT,ETHUSDT
FETCH_INTERVAL_SECONDS=5

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
